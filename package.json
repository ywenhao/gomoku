{
  "name": "yijing",
  "version": "1.5.14",
  "private": true,
  "description": "弈境 · 跨平台八棋种对弈与残局教学 · Native Shell (nsh.dev) · Windows / Linux / Android / macOS / Web",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nsh run .",
    "dev:web": "nsh run . --target web",
    "dev:android": "nsh run . --target android",
    "dev:ios": "nsh run . --target ios",
    "check": "nsh check",
    "test": "nsh test",
    "verify": "npm run check && npm test",
    "build": "nsh build .",
    "build:release": "nsh build . --release",
    "package:windows": "node scripts/package.mjs windows",
    "package:linux": "node scripts/package.mjs linux",
    "package:macos": "node scripts/package.mjs macos",
    "package:android": "node scripts/package.mjs android",
    "package:web": "node scripts/package.mjs web",
    "package:web:cloudflare": "node scripts/cloudflare-web.mjs",
    "package:ios": "node scripts/package.mjs ios",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  }
}
